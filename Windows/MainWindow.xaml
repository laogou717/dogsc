<Window x:Class="DogSC.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DogSC"
        Height="940" Width="1480" MinHeight="760" MinWidth="1160"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        FontFamily="Microsoft YaHei UI"
        Language="zh-CN"
        Background="#F4F7FC">
    <Border Margin="10" Background="#FFFFFF" BorderBrush="#DDE6F2" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E8EDF5" BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0" Padding="22,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <Border DockPanel.Dock="Left" Width="43" Height="43" CornerRadius="13"
                            Background="#1769F5" Margin="0,0,13,0">
                        <Grid>
                            <Ellipse Width="22" Height="16" Stroke="#FFFFFF" StrokeThickness="2" />
                            <Rectangle Width="5" Height="10" RadiusX="1" RadiusY="1"
                                       Fill="#FFFFFF" HorizontalAlignment="Right" Margin="0,0,7,0" />
                            <Ellipse Width="5" Height="5" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DogSC" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="Windows 预览版 · 轻量录制与剪辑" FontSize="12" Foreground="#73819A" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#F3F7FE" BorderBrush="#E3ECFA" BorderThickness="1"
                            CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#18A874" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="本地运行" Foreground="#52647E" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="202" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F8FAFE" BorderBrush="#E8EDF5" BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,18" Padding="15,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="NavRecordButton" Grid.Row="0" Style="{StaticResource NavButton}" Tag="Selected" Click="NavRecord_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉" FontFamily="Segoe UI Symbol" FontSize="20" Width="31" VerticalAlignment="Center" />
                                <TextBlock Text="录制" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavEditButton" Grid.Row="1" Style="{StaticResource NavButton}" Click="NavEdit_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂" FontFamily="Segoe UI Symbol" FontSize="19" Width="31" VerticalAlignment="Center" />
                                <TextBlock Text="编辑" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavExportButton" Grid.Row="2" Style="{StaticResource NavButton}" Click="NavExport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇧" FontFamily="Segoe UI Symbol" FontSize="21" Width="31" VerticalAlignment="Center" />
                                <TextBlock Text="导出" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettingsButton" Grid.Row="3" Style="{StaticResource NavButton}" Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="20" Width="31" VerticalAlignment="Center" />
                                <TextBlock Text="设置与帮助" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="5" Background="#EDF4FF" BorderBrush="#DCE9FF" BorderThickness="1"
                                CornerRadius="13" Padding="13" Margin="0,14,0,0">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="12" Background="#D9E8FF" HorizontalAlignment="Left">
                                    <TextBlock Text="D" FontSize="22" FontWeight="Bold" Foreground="#1769F5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="让灵感被更好地记录" FontSize="14" FontWeight="SemiBold" Margin="0,11,0,3" />
                                <TextBlock Text="录制 · 编辑 · 导出" FontSize="11" Foreground="#6D7E99" />
                                <Separator Margin="0,12,0,9" Background="#D6E4FA" />
                                <TextBlock Text="DogSC" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="v0.1.10  ·  预览版" FontSize="11" Foreground="#7C8AA2" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TabControl x:Name="MainTabs" Grid.Column="1" Margin="20,17,20,18"
                            Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid ClipToBounds="True">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem Header="录制">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.08*" />
                                    <ColumnDefinition Width="0.92*" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitle}" Text="录制模式" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="选择要捕获的屏幕范围" />
                                                <ComboBox x:Name="CaptureModeCombo" Visibility="Collapsed" SelectionChanged="CaptureModeCombo_SelectionChanged">
                                                    <ComboBoxItem Content="整个桌面" Tag="Desktop" />
                                                    <ComboBoxItem Content="指定窗口" Tag="Window" />
                                                    <ComboBoxItem Content="指定区域" Tag="Region" />
                                                </ComboBox>
                                                <UniformGrid Columns="3" Margin="0,2,0,8">
                                                    <Button x:Name="CaptureDesktopButton" Content="▣  全屏" Click="CaptureDesktop_Click" Margin="0,2,5,2" MinHeight="42" />
                                                    <Button x:Name="CaptureWindowButton" Content="▱  窗口" Click="CaptureWindow_Click" Margin="2" MinHeight="42" />
                                                    <Button x:Name="CaptureRegionButton" Content="⬚  区域" Click="CaptureRegion_Click" Margin="5,2,0,2" MinHeight="42" />
                                                </UniformGrid>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="录制帧率" Foreground="#65738B" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <ComboBox x:Name="FrameRateCombo" Width="125">
                                                        <ComboBoxItem Content="30 FPS" Tag="30" />
                                                        <ComboBoxItem Content="60 FPS" Tag="60" />
                                                    </ComboBox>
                                                    <Button Content="刷新窗口" Click="RefreshWindows_Click" VerticalAlignment="Center" Margin="8,2,0,4" />
                                                </StackPanel>
                                                <StackPanel x:Name="WindowSelectionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="要录制的窗口" />
                                                    <ComboBox x:Name="WindowCombo" DisplayMemberPath="Title" />
                                                </StackPanel>

                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitle}" Text="录制选项" />
                                                <CheckBox x:Name="SystemAudioCheckBox" Content="系统声音（WASAPI）" IsChecked="True" />
                                                <CheckBox x:Name="MicrophoneCheckBox" Content="麦克风录音" />
                                                <CheckBox x:Name="CameraOverlayCheckBox" Content="叠加摄像头画面" />
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="摄像头位置" />
                                                        <ComboBox x:Name="CameraPositionCombo">
                                                            <ComboBoxItem Content="右下" Tag="bottom-right" />
                                                            <ComboBoxItem Content="左下" Tag="bottom-left" />
                                                            <ComboBoxItem Content="右上" Tag="top-right" />
                                                            <ComboBoxItem Content="左上" Tag="top-left" />
                                                            <ComboBoxItem Content="居中" Tag="center" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="摄像头尺寸" />
                                                        <ComboBox x:Name="CameraSizeCombo">
                                                            <ComboBoxItem Content="小" Tag="small" />
                                                            <ComboBoxItem Content="中" Tag="medium" />
                                                            <ComboBoxItem Content="大" Tag="large" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox x:Name="ShowCursorCheckBox" Content="录制鼠标光标" IsChecked="True" />
                                                <CheckBox x:Name="RecordMarkerCheckBox" Content="启用录制标记（Ctrl+Alt+M）" IsChecked="True" />
                                                <TextBlock Text="标记保存在视频旁的 .markers.json 文件中。" FontSize="11" Foreground="#7A879C" Margin="2,0,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitle}" Text="区域设置" />
                                                <TextBlock Foreground="#65738B" FontSize="12" Text="支持拖动框选，也可以直接输入像素坐标。" Margin="0,0,0,9" />
                                                <UniformGrid Columns="4">
                                                    <StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="X" /><TextBox x:Name="RegionXTextBox" Text="320" TextChanged="RegionCoordinates_TextChanged" /></StackPanel>
                                                    <StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Y" /><TextBox x:Name="RegionYTextBox" Text="200" TextChanged="RegionCoordinates_TextChanged" /></StackPanel>
                                                    <StackPanel Margin="0,0,7,0"><TextBlock Style="{StaticResource FieldLabel}" Text="宽度" /><TextBox x:Name="RegionWidthTextBox" Text="1280" TextChanged="RegionCoordinates_TextChanged" /></StackPanel>
                                                    <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="高度" /><TextBox x:Name="RegionHeightTextBox" Text="720" TextChanged="RegionCoordinates_TextChanged" /></StackPanel>
                                                </UniformGrid>
                                                <Button Content="▧  拖动选择区域..." Click="SelectRegion_Click" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,0,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,12">
                                                    <TextBlock Style="{StaticResource SectionTitle}" Text="实时预览" Margin="0" />
                                                    <Border DockPanel.Dock="Right" Background="#E9F8F1" CornerRadius="7" Padding="8,4">
                                                        <TextBlock Text="本地采集" FontSize="11" Foreground="#14865E" />
                                                    </Border>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,10">
                                                    <TextBlock Style="{StaticResource SectionTitle}" Text="实时预览" Margin="0" />
                                                    <ComboBox x:Name="PreviewScaleCombo" Width="125" SelectedIndex="0" DockPanel.Dock="Right"
                                                              SelectionChanged="PreviewScaleCombo_SelectionChanged">
                                                        <ComboBoxItem Content="适应窗口" Tag="fit" />
                                                        <ComboBoxItem Content="填充窗口" Tag="fill" />
                                                    </ComboBox>
                                                </DockPanel>
                                                <Border Background="#E5EFFA" CornerRadius="12" Height="278" ClipToBounds="True">
                                                    <Grid>
                                                        <Image x:Name="LivePreviewImage" Stretch="Uniform" SnapsToDevicePixels="True" />
                                                        <StackPanel x:Name="LivePreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border Width="70" Height="70" Background="#DCEAFF" CornerRadius="22" HorizontalAlignment="Center">
                                                                <TextBlock Text="▣" FontSize="38" Foreground="#1769F5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="正在等待预览画面" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,5" />
                                                            <TextBlock Text="预览会随录制模式自动更新" TextWrapping="Wrap" TextAlignment="Center" Foreground="#6B7A91" FontSize="12" MaxWidth="310" />
                                                        </StackPanel>
                                                        <Border VerticalAlignment="Bottom" Background="#CC17243A" Padding="9,5">
                                                            <TextBlock Text="实时采集预览 · 每 0.6 秒刷新" Foreground="#FFFFFF" FontSize="11" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border Background="#F1F6FE" CornerRadius="10" Padding="11" Margin="0,9,0,12">
                                                    <DockPanel>
                                                        <TextBlock Text="i" FontWeight="Bold" Foreground="#1769F5" FontSize="18" DockPanel.Dock="Left" Margin="0,0,10,0" />
                                                        <TextBlock x:Name="LivePreviewStatusText" Text="预览用于确认采集范围；最终录制画面以导出文件为准。" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                                <TextBlock Text="当前输出文件" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="OutputPathTextBox" />
                                                <Button Content="选择保存位置..." Click="BrowseOutput_Click" HorizontalAlignment="Right" />
                                                <TextBlock Text="提示：请确认目标磁盘有足够空间；录制结束后会生成 MP4 文件。" Foreground="#73819A" FontSize="11" TextWrapping="Wrap" Margin="2,6,2,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SectionTitle}" Text="设备设置" />
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="麦克风设备（DirectShow）" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="刷新" Click="RefreshAudioDevices_Click" />
                                                    <ComboBox x:Name="MicrophoneCombo" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="摄像头设备（DirectShow）" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="刷新" Click="RefreshCameraDevices_Click" />
                                                    <ComboBox x:Name="CameraCombo" />
                                                </DockPanel>
                                                <TextBlock Text="设备列表来自 Windows 多媒体驱动与 FFmpeg。" Foreground="#73819A" FontSize="11" TextWrapping="Wrap" Margin="2,5,2,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="StartRecordingButton" Content="◉  开始录制" Style="{StaticResource PrimaryButton}" MinWidth="142" MinHeight="44" Click="StartRecording_Click" />
                                            <Button x:Name="PauseRecordingButton" Content="Ⅱ  暂停" MinWidth="92" MinHeight="44" IsEnabled="False" ToolTip="当前录制引擎暂不支持无损暂停" />
                                            <Button x:Name="StopRecordingButton" Content="■  停止" MinWidth="98" MinHeight="44" IsEnabled="False" Click="StopRecording_Click" />
                                            <Button x:Name="AddMarkerButton" Content="⚑  添加标记" MinWidth="112" MinHeight="44" IsEnabled="False" Click="AddRecordingMarker_Click" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="7,0,15,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="RecordingStatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="录制状态" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock x:Name="RecordingStatusText" Text="就绪。请选择录制范围与设备。" Foreground="#6B7A91" FontSize="12" TextWrapping="Wrap" Margin="16,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Expander Header="查看详细日志" Margin="4,8,4,0" MaxHeight="185">
                                        <TextBox x:Name="RecordingLogTextBox" Height="140" IsReadOnly="True" AcceptsReturn="True"
                                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="#F7F9FD" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="编辑与导出">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,11">
                                                <TextBlock Style="{StaticResource SectionTitle}" Text="片段预览" Margin="0" />
                                                <TextBlock Text="预览 / 裁剪 / 变速" Foreground="#73819A" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border Background="#101827" CornerRadius="11" Padding="4" MinHeight="235">
                                                <ContentControl x:Name="PreviewHost" />
                                            </Border>
                                            <DockPanel Margin="0,8,0,0">
                                                <Button x:Name="PreviewPlayButton" Content="▶  播放预览" Style="{StaticResource PrimaryButton}" Click="TogglePreview_Click" MinWidth="130" />
                                                <TextBlock Text="空格：播放 / 暂停" Foreground="#7B879B" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="片段属性" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="开始时间（秒）" />
                                                    <TextBox x:Name="ClipStartTextBox" Text="0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="结束时间（秒）" />
                                                    <TextBox x:Name="ClipEndTextBox" Text="0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="播放速度" />
                                                    <ComboBox x:Name="ClipSpeedCombo">
                                                        <ComboBoxItem Content="0.50x" Tag="0.5" />
                                                        <ComboBoxItem Content="0.75x" Tag="0.75" />
                                                        <ComboBoxItem Content="1.00x" Tag="1" />
                                                        <ComboBoxItem Content="1.25x" Tag="1.25" />
                                                        <ComboBoxItem Content="1.50x" Tag="1.5" />
                                                        <ComboBoxItem Content="2.00x" Tag="2" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <DockPanel Margin="0,8,0,0">
                                                <Button DockPanel.Dock="Right" Content="应用修改" Style="{StaticResource PrimaryButton}" Click="ApplyClipEdits_Click" />
                                                <TextBlock Text="支持 0.5× 至 2× 速度" Foreground="#7B879B" FontSize="11" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource SectionTitle}" Text="时间线" Margin="0" />
                                                <Button DockPanel.Dock="Right" Content="快捷键" Click="ShowShortcuts_Click" />
                                            </DockPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button Content="＋ 导入片段" Style="{StaticResource PrimaryButton}" Click="AddClips_Click" />
                                                <Button Content="打开项目" Click="LoadProject_Click" />
                                                <Button Content="保存项目" Click="SaveProject_Click" />
                                            </WrapPanel>
                                            <DataGrid x:Name="ClipsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                      IsReadOnly="True" SelectionMode="Single" SelectionChanged="ClipsGrid_SelectionChanged"
                                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="220">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="媒体文件" Binding="{Binding FileName}" Width="*" />
                                                    <DataGridTextColumn Header="入点" Binding="{Binding StartSeconds, StringFormat=F2}" Width="70" />
                                                    <DataGridTextColumn Header="出点" Binding="{Binding EndSeconds, StringFormat=F2}" Width="70" />
                                                    <DataGridTextColumn Header="速度" Binding="{Binding Speed, StringFormat=F2}" Width="62" />
                                                    <DataGridTextColumn Header="时长" Binding="{Binding DurationSeconds, StringFormat=F2}" Width="70" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Content="分割片段" Click="SplitClip_Click" />
                                                <Button Content="删除片段" Click="RemoveClip_Click" />
                                                <Button Content="上移" Click="MoveClipUp_Click" />
                                                <Button Content="下移" Click="MoveClipDown_Click" />
                                                <Button x:Name="UndoButton" Content="撤销" Click="Undo_Click" IsEnabled="False" />
                                                <Button x:Name="RedoButton" Content="重做" Click="Redo_Click" IsEnabled="False" />
                                            </WrapPanel>
                                            <TextBlock Text="录制标记（选择标记可跳转到对应时间）" Style="{StaticResource FieldLabel}" />
                                            <ListBox x:Name="RecordingMarkersList" Height="72" SelectionChanged="RecordingMarkersList_SelectionChanged"
                                                     DisplayMemberPath="DisplayLabel" BorderBrush="#E2E9F3" BorderThickness="1" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="导出设置" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="导出文件位置" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="浏览..." Click="BrowseExportPath_Click" />
                                                <TextBox x:Name="ExportOutputPathTextBox" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="画布比例" />
                                            <ComboBox x:Name="ExportAspectRatioCombo">
                                                <ComboBoxItem Content="16:9 横屏" Tag="16:9" />
                                                <ComboBoxItem Content="9:16 竖屏" Tag="9:16" />
                                                <ComboBoxItem Content="1:1 方形" Tag="1:1" />
                                                <ComboBoxItem Content="4:3" Tag="4:3" />
                                                <ComboBoxItem Content="3:2" Tag="3:2" />
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="画面适配" />
                                            <ComboBox x:Name="ExportFitModeCombo">
                                                <ComboBoxItem Content="完整显示（留边）" Tag="fit" />
                                                <ComboBoxItem Content="填满画布并裁切" Tag="fill" />
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="背景颜色" />
                                            <ComboBox x:Name="ExportBackgroundCombo">
                                                <ComboBoxItem Content="黑色" Tag="black" />
                                                <ComboBoxItem Content="深灰蓝" Tag="dark" />
                                                <ComboBoxItem Content="白色" Tag="white" />
                                                <ComboBoxItem Content="蓝色" Tag="blue" />
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="自定义背景图片（可选）" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="清除" Click="ClearBackgroundImage_Click" />
                                                <Button DockPanel.Dock="Right" Content="浏览..." Click="BrowseBackgroundImage_Click" />
                                                <TextBox x:Name="ExportBackgroundImageTextBox" IsReadOnly="True" />
                                            </DockPanel>
                                            <Separator Margin="0,14,0,12" Background="#E7EDF5" />
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="导出选项" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="分辨率高度" />
                                            <ComboBox x:Name="ExportResolutionCombo">
                                                <ComboBoxItem Content="1080p" Tag="1080" />
                                                <ComboBoxItem Content="1440p" Tag="1440" />
                                                <ComboBoxItem Content="4K" Tag="2160" />
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="帧率" />
                                            <ComboBox x:Name="ExportFrameRateCombo">
                                                <ComboBoxItem Content="30 FPS" Tag="30" />
                                                <ComboBoxItem Content="60 FPS" Tag="60" />
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="导出格式" />
                                            <ComboBox x:Name="ExportFormatCombo" SelectionChanged="ExportFormatCombo_SelectionChanged">
                                                <ComboBoxItem Content="MP4 视频" Tag="MP4" />
                                                <ComboBoxItem Content="M4A 音频" Tag="M4A" />
                                            </ComboBox>
                                            <Button x:Name="ExportButton" Content="⇧  开始导出" Style="{StaticResource PrimaryButton}" MinHeight="45" Margin="0,14,0,0" Click="Export_Click" />
                                            <TextBlock x:Name="EditorStatusText" Text="导入视频后即可编辑并导出。" Foreground="#6B7A91" FontSize="12" TextWrapping="Wrap" Margin="2,10,2,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#EDF4FF" BorderBrush="#DCE9FF" BorderThickness="1" CornerRadius="13" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="快捷键提示" FontWeight="SemiBold" Margin="0,0,0,7" />
                                            <TextBlock Text="Ctrl+O 导入视频" Foreground="#586B87" FontSize="12" Margin="0,2" />
                                            <TextBlock Text="Ctrl+S 保存项目" Foreground="#586B87" FontSize="12" Margin="0,2" />
                                            <TextBlock Text="Ctrl+E 导出媒体" Foreground="#586B87" FontSize="12" Margin="0,2" />
                                            <TextBlock Text="Ctrl+Z 撤销 · Ctrl+Y 重做" Foreground="#586B87" FontSize="12" Margin="0,2" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="设置与帮助">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="设置与帮助" FontSize="25" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBlock Text="管理设备、查看快捷键，并诊断本机录制环境。" Foreground="#6B7A91" Margin="0,0,0,20" />
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,13">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="设备检测" />
                                        <TextBlock Text="设备列表由当前 Windows 驱动和 FFmpeg 枚举提供。" Foreground="#6B7A91" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="刷新窗口列表" Click="RefreshWindows_Click" />
                                            <Button Content="检测麦克风" Click="RefreshAudioDevices_Click" />
                                            <Button Content="检测摄像头" Click="RefreshCameraDevices_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,13">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="快捷键" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Ctrl + O" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Row="0" Grid.Column="1" Text="导入视频" Foreground="#65738B" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Text="Ctrl + S" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="1" Text="保存项目" Foreground="#65738B" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="Ctrl + E" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="1" Text="导出媒体" Foreground="#65738B" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Text="Ctrl + Z" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Row="3" Grid.Column="1" Text="撤销" Foreground="#65738B" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" Text="Ctrl + Y / Ctrl + Shift + Z" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Row="4" Grid.Column="1" Text="重做" Foreground="#65738B" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="5" Text="Ctrl + Alt + M" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Row="5" Grid.Column="1" Text="录制时添加标记" Foreground="#65738B" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button Content="打开快捷键完整说明" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ShowShortcuts_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="关于 DogSC" />
                                        <TextBlock Text="DogSC Windows 预览版" FontWeight="SemiBold" />
                                        <TextBlock Text="此版本提供基础屏幕录制、片段剪辑、项目保存与媒体导出。部分 macOS 高级视觉效果尚未移植。" Foreground="#6B7A91" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        <TextBlock Text="日志位置：%LOCALAPPDATA%\DogSC\logs\startup.log" Foreground="#6B7A91" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>